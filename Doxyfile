# Doxygen configuration for SCD41
# Maintained for unified API documentation.

PROJECT_NAME           = "SCD41"
# Synchronized from library.json by scripts/generate_version.py.
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Bounded, externally scheduled SCD41 driver API"
OUTPUT_DIRECTORY       = .doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO

SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
STRIP_CODE_COMMENTS    = NO

INPUT                  = README.md CHANGELOG.md ASSUMPTIONS.md include/SCD41 docs/README.md docs/reference/scd41-protocol.md docs/porting/esp-idf.md docs/integration/external-i2c-owner.md docs/validation/hardware-hil.md
FILE_PATTERNS          = *.h *.md
RECURSIVE              = NO
EXCLUDE_PATTERNS       = */.pio/* */.git/* */test/* */docs/doxygen/* */docs/reference/vendor/*
EXCLUDE_SYMBOLS        = SCD41_VERSION_STRING SCD41_BUILD_DATE SCD41_BUILD_TIME SCD41_BUILD_TIMESTAMP SCD41_GIT_COMMIT SCD41_GIT_STATUS SCD41_VERSION_FULL
EXAMPLE_PATH           = examples/01_basic_bringup_cli

USE_MDFILE_AS_MAINPAGE = README.md
FULL_PATH_NAMES        = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
